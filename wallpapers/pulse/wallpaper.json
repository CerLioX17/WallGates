{
  "name": "Pulse",
  "author": "Wallgates",
  "description": "A circular audio visualizer driven by whatever your PC is playing — Spotify, YouTube, games. No setup.",
  "type": "shader",
  "entry": "pulse.frag",
  "preview": "preview.jpg",
  "license": "CC-BY-4.0",
  "version": "1.0.0",
  "tags": ["audio", "visualizer", "music"],
  "capabilities": ["audio"],
  "properties": {
    "radius": { "label": "Ring size", "type": "slider", "min": 0.1, "max": 0.4, "step": 0.01, "default": 0.22 },
    "height": { "label": "Bar height", "type": "slider", "min": 0.05, "max": 0.5, "step": 0.01, "default": 0.22 },
    "colorA": { "label": "Low frequencies", "type": "color", "default": "#22d3ee" },
    "colorB": { "label": "High frequencies", "type": "color", "default": "#ec4899" },
    "background": { "label": "Background", "type": "color", "default": "#07060d" },
    "mirror": { "label": "Mirror spectrum", "type": "bool", "default": true },
    "rotate": { "label": "Rotation speed", "type": "slider", "min": -1, "max": 1, "step": 0.05, "default": 0.1 }
  }
}
