{
  "name": "System Terminal",
  "author": "Wallgates",
  "description": "A full system monitor in two styles. Workstation: a full-screen monitoring console with systems status, CPU core grid, top processes, weather and forecast, a live event log built from real events, alerts, statistics and a small audio analyser. Classic: a clean terminal window. CPU, GPU, RAM and SSD load and temperatures, fans, network, UV and air quality.",
  "type": "html",
  "entry": "index.html",
  "preview": "preview.jpg",
  "license": "CC-BY-4.0",
  "version": "4.2.0",
  "tags": [
    "system",
    "monitor",
    "terminal",
    "hardware",
    "temperature",
    "nerd",
    "retro"
  ],
  "capabilities": [
    "system",
    "weather",
    "media",
    "audio"
  ],
  "properties": {
    "style": {
      "label": "Style",
      "type": "select",
      "default": "workstation",
      "options": [
        {
          "value": "workstation",
          "label": "Workstation (full screen)"
        },
        {
          "value": "classic",
          "label": "Classic terminal"
        }
      ]
    },
    "gw1": {
      "label": "Workstation look",
      "type": "group"
    },
    "wsPalette": {
      "label": "Colours",
      "type": "select",
      "default": "wallgates",
      "options": [
        {
          "value": "wallgates",
          "label": "Wallgates (violet / cyan)"
        },
        {
          "value": "amber",
          "label": "Amber"
        },
        {
          "value": "green",
          "label": "Green phosphor"
        },
        {
          "value": "cyan",
          "label": "Ice cyan"
        },
        {
          "value": "white",
          "label": "Mono white"
        },
        {
          "value": "custom",
          "label": "Custom (colours below)"
        }
      ]
    },
    "primaryColor": {
      "label": "Primary colour (custom)",
      "type": "color",
      "default": "#a78bfa"
    },
    "accentColor": {
      "label": "Accent colour (custom)",
      "type": "color",
      "default": "#22d3ee"
    },
    "textColor": {
      "label": "Text colour (custom)",
      "type": "color",
      "default": "#dcd8ff"
    },
    "bgColor1": {
      "label": "Background colour 1 (custom)",
      "type": "color",
      "default": "#06050d"
    },
    "bgColor2": {
      "label": "Background colour 2 (custom)",
      "type": "color",
      "default": "#0f0b20"
    },
    "gradientRotation": {
      "label": "Background gradient angle",
      "type": "slider",
      "min": 0,
      "max": 360,
      "step": 5,
      "default": 135
    },
    "wsSize": {
      "label": "Size (% of screen)",
      "type": "slider",
      "min": 50,
      "max": 100,
      "step": 1,
      "default": 100
    },
    "wsText": {
      "label": "Text size",
      "type": "slider",
      "min": 0.7,
      "max": 1.5,
      "step": 0.05,
      "default": 1
    },
    "titleFont": {
      "label": "Title font (Workstation)",
      "type": "select",
      "default": "orbitron",
      "options": [
        {
          "value": "same",
          "label": "Same as text"
        },
        {
          "value": "orbitron",
          "label": "Orbitron — sci-fi"
        },
        {
          "value": "rajdhani",
          "label": "Rajdhani — technical"
        }
      ]
    },
    "glow": {
      "label": "Text glow",
      "type": "slider",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "default": 0.5
    },
    "scanlines": {
      "label": "Scanlines",
      "type": "bool",
      "default": false
    },
    "scanlineOpacity": {
      "label": "Scanline opacity",
      "type": "slider",
      "min": 0.02,
      "max": 0.6,
      "step": 0.02,
      "default": 0.12
    },
    "scanlineSpeed": {
      "label": "Scanline speed",
      "type": "slider",
      "min": 0.1,
      "max": 5,
      "step": 0.1,
      "default": 1
    },
    "boot": {
      "label": "Boot sequence on start",
      "type": "bool",
      "default": true
    },
    "bootSpeed": {
      "label": "Boot line delay (ms)",
      "type": "slider",
      "min": 40,
      "max": 600,
      "step": 10,
      "default": 160
    },
    "gw2": {
      "label": "Workstation panels",
      "type": "group"
    },
    "showHeader": {
      "label": "Header bar",
      "type": "bool",
      "default": true
