{
  "name": "System Terminal",
  "author": "Wallgates",
  "description": "Every nerd stat on a retro CRT terminal: CPU, GPU, RAM and SSD with load, temperature and history; top 5 processes; network and fans; the time; weather with UV, air quality and a 3-day forecast; sunrise, sunset and moon; now playing. Boots with the Wallgates gate.",
  "type": "html",
  "entry": "index.html",
  "preview": "preview.jpg",
  "license": "CC-BY-4.0",
  "version": "2.0.0",
  "tags": [
    "system",
    "monitor",
    "terminal",
    "hardware",
    "temperature",
    "nerd",
    "retro"
  ],
  "capabilities": [
    "system",
    "audio",
    "weather",
    "media"
  ],
  "properties": {
    "g1": {
      "label": "Display",
      "type": "group"
    },
    "theme": {
      "label": "Theme",
      "type": "select",
      "default": "wallgates",
      "options": [
        {
          "value": "wallgates",
          "label": "Wallgates neon"
        },
        {
          "value": "mono",
          "label": "Monochrome"
        },
        {
          "value": "amber",
          "label": "Amber CRT"
        },
        {
          "value": "green",
          "label": "Green phosphor"
        }
      ]
    },
    "operator": {
      "label": "Operator name",
      "type": "text",
      "default": "OPERATOR"
    },
    "fontSize": {
      "label": "Text size",
      "type": "slider",
      "min": 0.6,
      "max": 1.6,
      "step": 0.05,
      "default": 1
    },
    "boot": {
      "label": "Boot sequence on start",
      "type": "bool",
      "default": true
    },
    "format24": {
      "label": "24-hour clock",
      "type": "bool",
      "default": true
    },
    "fahrenheit": {
      "label": "Use °F",
      "type": "bool",
      "default": false
    },
    "g2": {
      "label": "Panels",
      "type": "group"
    },
    "showWeather": {
      "label": "Weather & forecast",
      "type": "bool",
      "default": true
    },
    "showProcs": {
      "label": "Top processes",
      "type": "bool",
      "default": true
    },
    "showNet": {
      "label": "Network & fans",
      "type": "bool",
      "default": true
    },
    "showMedia": {
      "label": "Now playing",
      "type": "bool",
      "default": true
    },
    "showAudio": {
      "label": "Audio spectrum",
      "type": "bool",
      "default": true
    },
    "showLog": {
      "label": "System log",
      "type": "bool",
      "default": true
    },
    "showLogo": {
      "label": "ASCII logo",
      "type": "bool",
      "default": true
    },
    "n0": {
      "label": "Weather needs Wallgates → Settings → Weather & location: turn it on and pick your city.",
      "type": "note"
    },
    "g3": {
      "label": "Alerts",
      "type": "group"
    },
    "cpuTempMax": {
      "label": "CPU temperature alert (°C)",
      "type": "slider",
      "min": 50,
      "max": 105,
      "step": 1,
      "default": 85
    },
    "gpuTempMax": {
      "label": "GPU temperature alert (°C)",
      "type": "slider",
      "min": 50,
      "max": 105,
      "step": 1,
      "default": 83
    },
    "ssdTempMax": {
      "label": "SSD temperature alert (°C)",
      "type": "slider",
      "min": 40,
      "max": 90,
      "step": 1,
      "default": 65
    },
    "loadMax": {
      "label": "Load alert (%)",
      "type": "slider",
      "min": 50,
      "max": 100,
      "step": 1,
      "default": 92
    },
    "n1": {
      "label": "CPU and RAM temperatures on Windows need HWiNFO (free) running with “Shared Memory Support”. GPU and SSD temperatures work out of the box.",
      "type": "note"
    },
    "g4": {
      "label": "CRT effects",
      "type": "group"
    },
    "scanlines": {
      "label": "Scanlines",
      "type": "slider",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "default": 0.35
    },
    "noise": {
      "label": "Noise",
      "type": "slider",
      "min": 0,
      "max": 0.5,
      "step": 0.01,
      "default": 0.05
    },
    "glow": {
      "label": "Glow",
      "type": "slider",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "default": 0.55
    },
    "aberration": {
      "label": "Chromatic aberration",
      "type": "bool",
      "default": true
    },
    "vignette": {
      "label": "Vignette",
      "type": "slider",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "default": 0.55
    },
    "flicker": {
      "label": "Flicker",
      "type": "bool",
      "default": false
    }
  }
}