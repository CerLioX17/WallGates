{
  "name": "System Terminal",
  "author": "Wallgates",
  "description": "A clean command-prompt window with every nerd stat: CPU, GPU, RAM and SSD load and temperatures, top processes, network, fans, weather with UV and a 3-day forecast, sun and moon. Sits where you want it, without taking the whole screen.",
  "type": "html",
  "entry": "index.html",
  "preview": "preview.jpg",
  "license": "CC-BY-4.0",
  "version": "3.0.0",
  "tags": [
    "system",
    "monitor",
    "terminal",
    "hardware",
    "temperature",
    "nerd",
    "retro"
  ],
  "capabilities": [
    "system",
    "weather",
    "media"
  ],
  "properties": {
    "g1": {
      "label": "Window",
      "type": "group"
    },
    "theme": {
      "label": "Theme",
      "type": "select",
      "default": "cmd",
      "options": [
        {
          "value": "cmd",
          "label": "Command Prompt (grey on black)"
        },
        {
          "value": "powershell",
          "label": "PowerShell (blue)"
        },
        {
          "value": "wallgates",
          "label": "Wallgates (cyan / violet)"
        },
        {
          "value": "green",
          "label": "Green phosphor"
        },
        {
          "value": "amber",
          "label": "Amber"
        }
      ]
    },
    "position": {
      "label": "Position",
      "type": "select",
      "default": "right",
      "options": [
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "top-right",
          "label": "Top right"
        },
        {
          "value": "top-left",
          "label": "Top left"
        },
        {
          "value": "bottom-right",
          "label": "Bottom right"
        },
        {
          "value": "bottom-left",
          "label": "Bottom left"
        }
      ]
    },
    "width": {
      "label": "Window width (% of screen)",
      "type": "slider",
      "min": 28,
      "max": 80,
      "step": 1,
      "default": 42
    },
    "fontSize": {
      "label": "Text size",
      "type": "slider",
      "min": 0.7,
      "max": 1.5,
      "step": 0.05,
      "default": 1
    },
    "opacity": {
      "label": "Window opacity",
      "type": "slider",
      "min": 0.5,
      "max": 1,
      "step": 0.05,
      "default": 0.94
    },
    "titleBar": {
      "label": "Window title bar",
      "type": "bool",
      "default": true
    },
    "background": {
      "label": "Desktop background",
      "type": "select",
      "default": "black",
      "options": [
        {
          "value": "black",
          "label": "Black"
        },
        {
          "value": "graphite",
          "label": "Graphite"
        },
        {
          "value": "navy",
          "label": "Deep navy"
        },
        {
          "value": "wallgates",
          "label": "Wallgates dark gradient"
        }
      ]
    },
    "operator": {
      "label": "User name in the prompt",
      "type": "text",
      "default": "Operator"
    },
    "typing": {
      "label": "Type the command on start",
      "type": "bool",
      "default": true
    },
    "format24": {
      "label": "24-hour clock",
      "type": "bool",
      "default": true
    },
    "fahrenheit": {
      "label": "Use °F",
      "type": "bool",
      "default": false
    },
    "g2": {
      "label": "Sections",
      "type": "group"
    },
    "showProcs": {
      "label": "Top processes",
      "type": "bool",
      "default": true
    },
    "showNet": {
      "label": "Network & fans",
      "type": "bool",
      "default": true
    },
    "showWeather": {
      "label": "Weather & forecast",
      "type": "bool",
      "default": true
    },
    "showSun": {
      "label": "Sun & moon",
      "type": "bool",
      "default": true
    },
    "showMedia": {
      "label": "Now playing",
      "type": "bool",
      "default": true
    },
    "showHistory": {
      "label": "Load history (text sparklines)",
      "type": "bool",
      "default": true
    },
    "showLogo": {
      "label": "Wallgates ASCII logo",
      "type": "bool",
      "default": false
    },
    "n0": {
      "label": "Weather: Wallgates → Settings → Weather & location. CPU/RAM temperatures and fans: Settings → Advanced sensors.",
      "type": "note"
    },
    "g3": {
      "label": "Alerts (highlighted in red)",
      "type": "group"
    },
    "cpuTempMax": {
      "label": "CPU temperature alert (°C)",
      "type": "slider",
      "min": 50,
      "max": 105,
      "step": 1,
      "default": 85
    },
    "gpuTempMax": {
      "label": "GPU temperature alert (°C)",
      "type": "slider",
      "min": 50,
      "max": 105,
      "step": 1,
      "default": 83
    },
    "ssdTempMax": {
      "label": "SSD temperature alert (°C)",
      "type": "slider",
      "min": 40,
      "max": 90,
      "step": 1,
      "default": 65
    },
    "loadMax": {
      "label": "Load alert (%)",
      "type": "slider",
      "min": 50,
      "max": 100,
      "step": 1,
      "default": 92
    }
  }
}